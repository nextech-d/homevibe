# Copy to .env.local for local development.
# In Vercel: Project → Settings → Environment Variables

# Neon Postgres (required for database-backed catalog)
# Create free project at https://neon.tech — paste the connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Admin panel (/admin) — pick a strong password; never commit the real value
ADMIN_PASSWORD=change-me-to-a-strong-password

# Order email notifications (optional — Resend: https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=HomeVibe <onboarding@resend.dev>
ORDER_NOTIFY_EMAIL=hello@homevibe.co.ke

# Staging: keep true until payments + database are fully live.
NEXT_PUBLIC_DEMO_MODE=true

# Public site URL for SEO (sitemap, Open Graph). Use your custom domain when ready.
NEXT_PUBLIC_SITE_URL=https://homevibe.co.ke

# On-demand cache refresh when admin publishes storefront changes (must match API STOREFRONT_REVALIDATE_SECRET)
REVALIDATE_SECRET=change-me-to-a-long-random-secret

# Leave these empty on the shop (homevibe.co.ke) until the extra Vercel projects exist.
# Do not paste another store's URL (e.g. app.phonekenya.co.ke or plexa.scentfied.co.ke).
# Local API: http://localhost:4000
# After you create the API project: https://api.homevibe.co.ke/api
NEXT_PUBLIC_API_URL=

# Local admin: http://localhost:5173
# After you create the admin project: https://admin.homevibe.co.ke
ADMIN_APP_URL=

# Set true to disable legacy /admin API routes (use with ADMIN_APP_URL)
DISABLE_LEGACY_ADMIN=false

# Contact & social (optional — defaults exist in app/config/site.ts)
NEXT_PUBLIC_WHATSAPP_NUMBER=254182230250
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/homevibe
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/homevibe
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@homevibe
