{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/gateway$", "dest": "/api/gateway" },
    { "src": "^/api/(?!gateway(?:/|\\?|$)|health$|auth/admin/login$|auth/admin/me$)(.*)$", "dest": "/api/gateway" }
  ],
  "functions": {
    "api/gateway.ts": {
      "includeFiles": "prisma/**",
      "memory": 1024
    },
    "api/health.ts": {
      "memory": 256
    },
    "api/auth/admin/login.ts": {
      "memory": 256
    },
    "api/auth/admin/me.ts": {
      "memory": 256
    }
  }
}