generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum BrandTier {
  signature
  partner
}

enum StockStatus {
  in_stock
  low_stock
  out_of_stock
}

enum ContentPostType {
  blog
  article
}

model Brand {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  name            String
  tier            BrandTier @default(partner)
  origin          String
  logoUrl         String?   @map("logo_url")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  sortOrder       Int       @default(0) @map("sort_order")
  isFeatured      Boolean   @default(false) @map("is_featured")
  products        Product[]

  @@map("brands")
}

model Category {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  label         String
  navLabel      String        @map("nav_label")
  description   String
  sortOrder     Int           @default(0) @map("sort_order")
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         Int       @id @default(autoincrement())
  categoryId Int       @map("category_id")
  slug       String
  label      String
  sortOrder  Int       @default(0) @map("sort_order")
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id              Int                @id @default(autoincrement())
  slug            String             @unique
  name            String
  brandId         Int                @map("brand_id")
  subcategoryId   Int                @map("subcategory_id")
  priceKes        Int                @map("price_kes")
  stockStatus     StockStatus        @default(in_stock) @map("stock_status")
  isPublished     Boolean            @default(true) @map("is_published")
  isFeatured      Boolean            @default(false) @map("is_featured")
  specs           String
  description     String
  metaTitle       String?            @map("meta_title")
  metaDescription String?            @map("meta_description")
  highlights      Json
  primaryPhotoId  String             @map("primary_photo_id")
  galleryPhotoIds Json               @map("gallery_photo_ids")
  brand           Brand              @relation(fields: [brandId], references: [id])
  subcategory     Subcategory        @relation(fields: [subcategoryId], references: [id])
  featuredTop     FeaturedHomeSlot[] @relation("FeaturedTop")
  featuredBottom  FeaturedHomeSlot[] @relation("FeaturedBottom")
  orderItems      OrderItem[]

  @@index([brandId])
  @@index([subcategoryId])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("products")
}

model FeaturedHomeSlot {
  id              Int      @id @default(autoincrement())
  columnIndex     Int      @unique @map("column_index")
  topProductId    Int      @map("top_product_id")
  bottomProductId Int?     @map("bottom_product_id")
  topProduct      Product  @relation("FeaturedTop", fields: [topProductId], references: [id])
  bottomProduct   Product? @relation("FeaturedBottom", fields: [bottomProductId], references: [id])

  @@map("featured_home_slots")
}

enum OrderStatus {
  confirmed
  preparing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

model Order {
  id              Int           @id @default(autoincrement())
  trackingId      String        @unique @map("tracking_id")
  status          OrderStatus   @default(confirmed)
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  customerPhone   String      @map("customer_phone")
  deliveryAddress String      @map("delivery_address")
  deliveryCity    String      @map("delivery_city")
  totalKes        Int         @map("total_kes")
  orderDate       DateTime    @default(now()) @map("order_date")
  userId          Int?        @map("user_id")
  items           OrderItem[]
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([trackingId])
  @@index([orderDate])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int?    @map("product_id")
  name      String
  priceKes  Int     @map("price_kes")
  quantity  Int
  imageUrl  String  @map("image_url")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String
  phone        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  sessions     Session[]
  addresses    SavedAddress[]
  orders       Order[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SavedAddress {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  label       String  @default("Home")
  addressLine String  @map("address_line")
  city        String
  isDefault   Boolean @default(false) @map("is_default")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_addresses")
}

model SiteSetting {
  key   String @id
  value String

  @@map("site_settings")
}

model FaqItem {
  id        Int    @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int    @default(0) @map("sort_order")

  @@map("faq_items")
}

model ContentPost {
  id              Int             @id @default(autoincrement())
  type            ContentPostType
  slug            String
  title           String
  excerpt         String          @default("")
  body            String
  metaTitle       String?         @map("meta_title")
  metaDescription String?         @map("meta_description")
  ogImageUrl      String?         @map("og_image_url")
  author          String?
  isPublished     Boolean         @default(false) @map("is_published")
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([type, slug])
  @@index([type, isPublished])
  @@map("content_posts")
}
